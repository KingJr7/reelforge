# Copiez ce fichier vers .env et remplissez les valeurs.
# Ne commitez jamais le .env contenant vos vraies clés.

# ElevenLabs (voix + timestamps mot par mot)
ELEVENLABS_API_KEY=votre_cle_elevenlabs_ici
ELEVENLABS_VOICE_ID=votre_voice_id_ici
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Pexels (B-rolls images et vidéos)
PEXELS_API_KEY=votre_cle_pexels_ici
